# TradePilot AI — copy to .env and fill in. Never commit .env.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
# Extra browser origins allowed to call the API with cookies (Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173
# Local Homebrew Postgres. In Docker Compose this host becomes `db`.
DATABASE_URL=postgresql+psycopg://tradepilot:local-dev-only@localhost:5432/tradepilot
SESSION_SECRET=replace-with-a-random-local-secret

# fixture = deterministic offline tool script; anthropic = Claude tool calls; gemini = Gemini tool calls.
AI_MODE=fixture
# Gemini API key (free tier available at aistudio.google.com) and a model ID it supports.
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# A model ID your API account supports, e.g. claude-opus-5-5.
ANTHROPIC_MODEL=
# Reasoning effort: low | medium | high | xhigh | max.
AI_EFFORT=medium
AI_MAX_TOOL_CALLS=20
AI_MAX_RUN_SECONDS=180

# fixture = offline fake PayPal adapter; paypal_sandbox = real Sandbox REST APIs.
PAYMENT_MODE=fixture
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# Sandbox *personal* account email that receives tool-provider Payouts in the demo.
PAYPAL_PAYOUT_RECEIVER=

# fixture = canned market prices; live = Channel3 API.
CHANNEL3_MODE=fixture
CHANNEL3_API_KEY=

# AG Studio licence (45-day trial). Exposed to the browser bundle by design; without it Studio shows a watermark.
VITE_AG_STUDIO_LICENSE_KEY=

ENABLE_SCENARIOS=true
PORT=8000
